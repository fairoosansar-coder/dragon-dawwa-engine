# GEMINI_API_KEY: Enables Ask, hadith research, Gemini neural voices (Puck/Fenrir/Kore/Orus/Zephyr) and OCR.
# Replace the placeholder with a real key. Restart npm run dev after saving.
# Confirm GET /api/health shows "ai": true. The robotic browser voice is not used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP port for the Express server (defaults to 3000).
PORT=3000

# DD_PERSIST_DIR: Survives restarts. On this Mac the server uses
# /Volumes/50/Dragon Dawwa/persistent/dragon-dawwa when that disk is mounted.
# Railway's container disk is wiped on every deploy. Mount a volume and set this
# to the mount path before deploying. There is no database or volume on the live service yet.
# DD_PERSIST_DIR=/data
#
# KF_DATA_DIR: Used only when DD_PERSIST_DIR is unset. Editorial guides, reviews, and error reports go here.
# KF_DATA_DIR=/var/lib/dragon-dawwa

# EDITORIAL_USERS: JSON array of editorial accounts. Leave unset to disable the editorial desk.
# Each token must be a random string of at least 24 characters (e.g. `openssl rand -hex 24`).
# Roles: author, source-checker, religious-reviewer, language-reviewer, publisher.
# "credential" is shown publicly next to a religious review.
# EDITORIAL_USERS='[{"id":"a1","name":"Editor name","roles":["author"],"token":"replace-with-a-long-random-token"}]'

# REPORTS_PER_15_MIN: Error reports accepted per client per 15 minutes (defaults to 10).

# Cloudflare R2 audio. GET /api/episodes/:id/stream forwards Range and pipes the object.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_AUDIO_PREFIX=episodes/

# Supabase idempotency. When URL and key are set, a status=done row for the same
# hadith_input and language is returned before Gemini or Parallel.
# Table research_records: id, status, language, hadith_input, question, category, kind, data jsonb.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_RESEARCH_TABLE=research_records
