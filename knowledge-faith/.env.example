# GEMINI_API_KEY: Enables Ask, hadith research, Gemini neural voices and OCR.
# Without it, the roundtable and Voice studio still speak using the browser's
# built-in voice. The Qur'an reader, hadith library and prayer tools work fully.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP port for the Express server (defaults to 3000).
PORT=3000
