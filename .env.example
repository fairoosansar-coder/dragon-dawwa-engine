# Backend only. Never use VITE_ prefixes for any of these credentials.
GEMINI_API_KEY=
# Choose an enabled model in your Google project.
GEMINI_MODEL=gemini-2.5-flash
SUNNAH_API_KEY=
# The search route is not documented in the published Sunnah.com specification.
# Set these only after the provider confirms the search contract for your key.
SUNNAH_SEARCH_CONTRACT_CONFIRMED=0
SUNNAH_SEARCH_QUERY_PARAM=
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=
# Use production only with approved production credentials.
QURAN_ENV=prelive

# Existing app hosting URL (used by deployment integrations).
APP_URL=
