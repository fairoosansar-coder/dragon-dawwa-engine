+    /**
+     * Lets optional extensions remove results after any driver has completed
+     * retrieval, without binding a driver to an application module.
+     */
+    protected function filterResults(SearchRequest $request, ResultSet $resultSet): ResultSet
+    {
+        $event = new ContentGuardEvent([
+            'target' => $resultSet,
+            'attributes' => ['request' => $request],
+            'user' => $request->user,
+            'operation' => 'content.search.cached',
+        ]);
+        $this->trigger(self::EVENT_FILTER_RESULTS, $event);
+        if (!$event->isValid) {
+            $resultSet->results = [];
+            $resultSet->pagination->totalCount = 0;
+        }
